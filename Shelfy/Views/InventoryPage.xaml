<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Shelfy.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Shelfy.ViewModels"
    xmlns:models="clr-namespace:Shelfy.Models"
    x:DataType="vm:InventoryViewModel"
    Title="Kilerim"
    BackgroundColor="#F5F5F7">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Elle Ekle" Command="{Binding GoToManualEntryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <SearchBar Grid.Row="0"
                   Placeholder="Ürün veya marka ara..."
                   Text="{Binding SearchText}"
                   Margin="12,12,12,0" />

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding LoadItemsCommand}">
                <CollectionView ItemsSource="{Binding PantryItems}"
                                 Margin="12,12,12,80">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PantryItem">
                            <Border Padding="10" BackgroundColor="White" Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="12">
                                    <Border StrokeShape="RoundRectangle 12" HeightRequest="60" WidthRequest="60">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Brand}" FontSize="12" TextColor="Gray" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Quantity, StringFormat='Adet: {0}'}" FontSize="12" />
                                            <Label Text="{Binding ExpirationDate, StringFormat='SKT: {0:dd/MM/yyyy}'}"
                                                   FontSize="12"
                                                   TextColor="{Binding IsExpired, Converter={StaticResource BoolToColorConverter}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <ImageButton Grid.Column="2" Source="delete_icon.png" HeightRequest="24" WidthRequest="24"
                                                 VerticalOptions="Center"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=DeleteItemCommand}"
                                                 CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                <Label Text="Kileriniz boş" FontSize="18" TextColor="Gray" HorizontalOptions="Center" />
                <Label Text="Taramaya başlayarak ürün ekleyin" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowNoResults}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                <Label Text="Sonuç bulunamadı" FontSize="18" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Button Text="＋"
                    Command="{Binding GoToScanCommand}"
                    HeightRequest="60" WidthRequest="60"
                    CornerRadius="30" FontSize="26"
                    BackgroundColor="#4CAF50" TextColor="White"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,20,24" />
        </Grid>
    </Grid>
</ContentPage>