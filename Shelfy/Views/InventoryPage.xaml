<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Shelfy.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Shelfy.ViewModels"
    xmlns:models="clr-namespace:Shelfy.Core"
    xmlns:strings="clr-namespace:Shelfy.Resources.Strings"
    x:DataType="vm:InventoryViewModel"
    Title="{x:Static strings:AppResources.Inventory_Title}"
    BackgroundColor="#F5F5F7">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Inventory_AddManually}" Command="{Binding GoToManualEntryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <SearchBar Grid.Row="0"
                   Placeholder="{x:Static strings:AppResources.Inventory_SearchPlaceholder}"
                   Text="{Binding SearchText}"
                   Margin="12,12,12,0" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="12,4,12,0">
            <Picker Grid.Column="0"
                    Title="{x:Static strings:AppResources.Sort_Title}"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}" />

            <Picker Grid.Column="1"
                    Title="{x:Static strings:AppResources.Category_Title}"
                    ItemsSource="{Binding CategoryFilterOptions}"
                    SelectedItem="{Binding SelectedCategory}" />
        </Grid>

        <Grid Grid.Row="2">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding LoadItemsCommand}">
                <CollectionView ItemsSource="{Binding PantryItems}"
                                 Margin="12,12,12,80">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PantryItem">
                            <Border Padding="10" BackgroundColor="White" Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="12">
                                    <Border StrokeShape="RoundRectangle 12" HeightRequest="60" WidthRequest="60">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Brand}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding Category}" FontSize="10" TextColor="#4CAF50" />

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0,4,0,0">
                                            <Button Text="-" FontSize="14" WidthRequest="26" HeightRequest="26" Padding="0" CornerRadius="13"
                                                    BackgroundColor="#EEEEEE" TextColor="Black"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=DecrementQuantityCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Label Text="{Binding Quantity}" FontSize="13" VerticalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" />
                                            <Button Text="+" FontSize="14" WidthRequest="26" HeightRequest="26" Padding="0" CornerRadius="13"
                                                    BackgroundColor="#EEEEEE" TextColor="Black"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=IncrementQuantityCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Label Text="{Binding ExpirationDate, StringFormat={x:Static strings:AppResources.Inventory_Expiry_Format}}"
                                                   FontSize="12" Margin="8,0,0,0"
                                                   TextColor="{Binding ., Converter={StaticResource ExpiryToColorConverter}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <ImageButton Grid.Column="2" Source="delete_icon.png" HeightRequest="24" WidthRequest="24"
                                                 VerticalOptions="Start"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=DeleteItemCommand}"
                                                 CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                <Label Text="📦" FontSize="48" HorizontalOptions="Center" />
                <Label Text="{x:Static strings:AppResources.Inventory_Empty_Title}" FontSize="18" TextColor="Gray" HorizontalOptions="Center" />
                <Label Text="{x:Static strings:AppResources.Inventory_Empty_Subtitle}" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowNoResults}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                <Label Text="🔍" FontSize="40" HorizontalOptions="Center" />
                <Label Text="{x:Static strings:AppResources.Inventory_NoResults}" FontSize="18" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Button Text="＋"
                    Command="{Binding GoToScanCommand}"
                    HeightRequest="60" WidthRequest="60"
                    CornerRadius="30" FontSize="26"
                    BackgroundColor="#4CAF50" TextColor="White"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,20,24" />
        </Grid>
    </Grid>
</ContentPage>