<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Shelfy.Views.ManualEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Shelfy.ViewModels"
    x:DataType="vm:ManualEntryViewModel"
    Title="Ürün Ekle"
    BackgroundColor="#F5F5F7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Ürün Adı *" FontAttributes="Bold" />
            <Entry Text="{Binding ProductName}" Placeholder="Örn: Tam Yağlı Süt" />

            <Label Text="Marka" FontAttributes="Bold" />
            <Entry Text="{Binding Brand}" Placeholder="Örn: Sütaş" />

            <Label Text="Kategori" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" />

            <Label Text="Ürün Fotoğrafı (opsiyonel)" FontAttributes="Bold" />

            <Border StrokeShape="RoundRectangle 12" HeightRequest="150" WidthRequest="150"
                    HorizontalOptions="Center" Stroke="LightGray" IsVisible="{Binding HasImage}">
                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="📷 Fotoğraf Çek"
                        Command="{Binding TakePhotoCommand}"
                        BackgroundColor="#2196F3" TextColor="White"
                        CornerRadius="10" HeightRequest="44" FontSize="13"
                        IsVisible="{Binding IsCameraSupported}" />

                <Button Grid.Column="1" Text="🖼️ Galeriden Seç"
                        Command="{Binding PickPhotoCommand}"
                        BackgroundColor="#2196F3" TextColor="White"
                        CornerRadius="10" HeightRequest="44" FontSize="13" />
            </Grid>

            <Button Text="Fotoğrafı Kaldır"
                    Command="{Binding RemovePhotoCommand}"
                    BackgroundColor="Transparent" TextColor="Red" FontSize="12"
                    IsVisible="{Binding HasImage}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="Adet" FontAttributes="Bold" />
                    <Stepper Minimum="1" Maximum="50" Value="{Binding Quantity}" />
                    <Label Text="{Binding Quantity}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Son Kullanma Tarihi *" FontAttributes="Bold" />
                    <DatePicker Date="{Binding ExpirationDate}" Format="dd/MM/yyyy" />
                    <Label Text="⚠️ Tarihi seçmelisiniz"
                           FontSize="11" TextColor="OrangeRed"
                           IsVisible="{Binding HasSelectedExpirationDate, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Grid>

            <Button Text="Kilere Ekle"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#4CAF50" TextColor="White"
                    CornerRadius="12" HeightRequest="50" Margin="0,20,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding HasSelectedExpirationDate}" Value="False">
                        <Setter Property="BackgroundColor" Value="Gray" />
                        <Setter Property="Opacity" Value="0.6" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Vazgeç"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent" TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>